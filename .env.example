# Server-only SQLite path, relative to the project working directory.
DATABASE_PATH=.data/vigiles-urbani.sqlite
# Optional: use MapTiler instead of public OpenStreetMap tiles and Photon search.
# Public browser key. Restrict it to your application origins in MapTiler.
VITE_MAPTILER_KEY=
# Optional compatible self-hosted Photon endpoint. Public services have usage limits.
VITE_PHOTON_URL=https://photon.komoot.io/api/

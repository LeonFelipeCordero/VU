        "locations_latitude_check": {
          "name": "locations_latitude_check",
          "value": "typeof(\"locations\".\"latitude\") IN ('real', 'integer') AND \"locations\".\"latitude\" BETWEEN -90 AND 90"
        },
        "locations_longitude_check": {
          "name": "locations_longitude_check",
          "value": "typeof(\"locations\".\"longitude\") IN ('real', 'integer') AND \"locations\".\"longitude\" BETWEEN -180 AND 180"
        },
        "locations_source_check": {
          "name": "locations_source_check",
          "value": "\"locations\".\"source\" IN ('app', 'crawler')"
        },
        "locations_description_check": {
          "name": "locations_description_check",
          "value": "length(\"locations\".\"description\") <= 2000 AND length(trim(\"locations\".\"description\", char(9,10,11,12,13,32,160,5760,8192,8193,8194,8195,8196,8197,8198,8199,8200,8201,8202,8232,8233,8239,8287,12288,65279))) > 0 AND instr(\"locations\".\"description\", char(0)) = 0"
        },
        "locations_created_at_check": {
          "name": "locations_created_at_check",
          "value": "typeof(\"locations\".\"created_at\") = 'integer' AND \"locations\".\"created_at\" >= 0"
        },
        "locations_updated_at_check": {
          "name": "locations_updated_at_check",
          "value": "typeof(\"locations\".\"updated_at\") = 'integer' AND \"locations\".\"updated_at\" >= \"locations\".\"created_at\""
        }
      }

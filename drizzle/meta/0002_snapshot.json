        "incidents_coordinates_check": {
          "name": "incidents_coordinates_check",
          "value": "(\"incidents\".\"latitude\" IS NULL AND \"incidents\".\"longitude\" IS NULL) OR\n    (\"incidents\".\"latitude\" IS NOT NULL AND \"incidents\".\"longitude\" IS NOT NULL AND\n    typeof(\"incidents\".\"latitude\") IN ('real','integer') AND \"incidents\".\"latitude\" BETWEEN -90 AND 90 AND\n    typeof(\"incidents\".\"longitude\") IN ('real','integer') AND \"incidents\".\"longitude\" BETWEEN -180 AND 180)"
        },
        "incidents_interval_check": {
          "name": "incidents_interval_check",
          "value": "\"incidents\".\"occurred_end\" IS NULL OR\n    (\"incidents\".\"occurred_start\" IS NOT NULL AND \"incidents\".\"occurred_end\" >= \"incidents\".\"occurred_start\")"
        },
        "incidents_synthetic_check": {
          "name": "incidents_synthetic_check",
          "value": "\"incidents\".\"is_synthetic\" IN (0, 1)"
        }

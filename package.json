{
  "name": "vigiles-urbani",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs",
    "check": "tsc --noEmit",
    "atlas:install": "cargo install --git https://github.com/LeonFelipeCordero/atlas.git --rev 7247134a20536f1f6bfc73293c38a38b2bb263d7 --locked --bin atlas atlas-rust",
    "atlas:report": "atlas report -f .",
    "atlas:check": "atlas check -f .",
    "test": "vitest run",
    "data:import": "tsx --env-file-if-exists=.env.local scripts/import-dataset.ts",
    "data:export": "tsx --env-file-if-exists=.env.local scripts/export-incidents.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts"
  },
  "dependencies": {
    "@maptiler/client": "3.1.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "1.169.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "maplibre-gl": "6.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "nitro": "3.0.260903-beta",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
